# Copy to .env and fill in. The real .env is gitignored — never commit credentials.

# Where the contractor_roster "source system" lives.
# Default (unset) = local SQLite at data/sources/contractor_roster.db — zero setup.
# For Postgres: postgresql+psycopg://helios_ro:<password>@localhost:5432/helios
HELIOS_DB_URL=

# The star-schema warehouse. Unset = SQLite at data/warehouse/helios.db.
HELIOS_WAREHOUSE_URL=

# Comma-separated origins allowed to call the API. Default "*".
# Narrow this if the UI is served from a different host than the API.
HELIOS_CORS_ORIGINS=

# --- NL agent -------------------------------------------------------------
# Unset = the deterministic offline generator, so guardrails and the golden-set
# evaluation still run. Set it for live Claude-generated SQL.
ANTHROPIC_API_KEY=

# --- Alerting -------------------------------------------------------------
# Alerts ALWAYS land in data/alerts/. Everything below is additional delivery;
# a channel is only enabled when its config is complete.
# Verify wiring without waiting for a real breach: python -m src.alerting --test

# Slack incoming webhook.
HELIOS_SLACK_WEBHOOK_URL=

# Email. Needs FROM + TO, plus either a Resend key or an SMTP host.
HELIOS_ALERT_FROM=
HELIOS_ALERT_TO=
RESEND_API_KEY=
# SMTP alternative (ignored when RESEND_API_KEY is set):
HELIOS_SMTP_HOST=
HELIOS_SMTP_PORT=587
HELIOS_SMTP_USER=
HELIOS_SMTP_PASSWORD=

# Thresholds. Defaults shown; the net-variance rule needs BOTH bars cleared.
HELIOS_ALERT_NET_VARIANCE_PCT=0.05
HELIOS_ALERT_NET_VARIANCE_ABS=100000
HELIOS_ALERT_MATERIAL_COUNT=5
HELIOS_ALERT_CRITICAL_PCT=0.15
